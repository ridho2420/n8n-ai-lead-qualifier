    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"need_fit\": {\n      \"type\": \"integer\",\n      \"enum\": [\n        0,\n        12,\n        25\n      ]\n    },\n    \"is_spam\": {\n      \"type\": \"boolean\"\n    },\n    \"is_job_seeker\": {\n      \"type\": \"boolean\"\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"need_fit\",\n    \"is_spam\",\n    \"is_job_seeker\",\n    \"reason\"\n  ]\n}"
      },
      "id": "e49fcd6a-c2bf-4c24-b39f-2c68bac77d9f",
      "name": "Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -112,
        304
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Combine Score\n// Adds the AI's need assessment to the deterministic scores,\n// applies the special rules, and sets the final category.\n// If the AI call failed, the lead is flagged so the next node can send it to the error path.\n// The AI node returns exactly one item per lead, in the same order,\n// so the matching lead is found by position.\nconst lead = $('Prepare Lead').all()[$itemIndex].json;\n\nif ($json.error) {\n  return { json: { ...lead, ai_failed: true, error: $json.error } };\n}\n\nconst ai = $json.output || {};\n\nconst fit = [0, 12, 25].includes(Number(ai.need_fit)) ? Number(ai.need_fit) : 0;\nconst isSpam = ai.is_spam === true;\nconst isJobSeeker = ai.is_job_seeker === true;\n\nlet score = lead.score_budget + lead.score_timeline + fit + lead.score_size;\nif (isSpam) score = 0;\nelse if (isJobSeeker) score = Math.min(score, 10);\n\nconst category = score >= 70 ? 'hot' : score >= 40 ? 'warm' : 'cold';\n\nlet reason = String(ai.reason || '').trim();\nif (isSpam && !reason.startsWith('SPAM:')) reason = 'SPAM: ' + reason;\n\nreturn {\n  json: {\n    ...lead,\n    ai_failed: false,\n    need_fit: fit,\n    is_spam: isSpam,\n    is_job_seeker: isJobSeeker,\n    lead_score: score,\n    lead_category: category,\n    lead_reason: reason,\n  },\n};"
      },
      "id": "9464baf5-1aa6-4f3e-8215-8909ff093f7d",
      "name": "Combine Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        64
      ]
    },
