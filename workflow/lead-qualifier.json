        "jsCode": "// Prepare Error\n// Turns a lead that failed (AI or HubSpot) into one Error Log row.\n// The original form input is kept in raw_input, so the lead is never lost and can be re-processed.\nlet lead = {};\ntry { lead = $('Combine Score').item.json; } catch (e) { lead = $json; }\n\nconst err = $json.error;\nlet message = 'Unknown error';\nif (typeof err === 'string') {\n  message = err;\n} else if (err) {\n  message = err.message || JSON.stringify(err);\n  if (err.description && !message.includes(err.description)) message += ' | ' + err.description;\n}\n\nreturn {\n  json: {\n    timestamp: new Date().toISOString(),\n    step: $json.step,\n    error_message: String(message).slice(0, 500),\n    lead_email: lead.email || '',\n    raw_input: lead.raw_input || '',\n    execution_id: $execution.id,\n  },\n};"
      },
